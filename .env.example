# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set for fast guild-scoped command registration during development.
# Leave blank to register commands globally (can take up to an hour to propagate).
DISCORD_GUILD_ID=
# Discord user ID of the bot owner - always allowed to create events / manage config.
OWNER_DISCORD_ID=

# Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
GRAPH_API_VERSION=v21.0

# Misc
DEFAULT_TIMEZONE=America/Chicago
DATABASE_PATH=./data/bot.sqlite3
LOG_LEVEL=info
