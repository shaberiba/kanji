# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional, dev convenience only: registers commands to just this one guild
# (near-instant) instead of globally. Event sync/reminders work in EVERY
# guild the bot is a member of regardless of this setting - it only affects
# command registration speed. Leave blank for a multi-server bot (register
# globally instead; can take up to an hour to propagate on first run).
DISCORD_GUILD_ID=
# Discord user ID of the bot owner - always allowed to create events / manage config.
OWNER_DISCORD_ID=

# Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
GRAPH_API_VERSION=v21.0

# Misc
DEFAULT_TIMEZONE=America/Chicago
DATABASE_PATH=./data/bot.sqlite3
LOG_LEVEL=info
# How often (minutes) to check the Facebook Page for new events to announce.
EVENTS_POLL_INTERVAL_MINUTES=15
